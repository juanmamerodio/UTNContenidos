# UTNContenidos Beta — Variables de entorno (ejemplo, NO commitear valores reales)
# Copiar a .env.local (local) y a Vercel Environment Variables (producción)

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# IA
GEMINI_API_KEY=AIza...
OPENROUTER_API_KEY=sk-or-v1-...      # opcional (fallback/banco de pruebas)
IA_MODEL=gemini-2.5-flash             # modelo por defecto

# Auth (bootstrap root)
ROOT_AUTH_PASS=root-root-utn           # password INTERNO del auth user root (ver seed_root.mjs)

# App
APP_URL=https://utncontenidos.vercel.app